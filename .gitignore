# The assessment brief is not public, and must never be committed.
ASSESSMENT.md
*.pdf
candidate_pack/

.venv/
__pycache__/
*.pyc
.pytest_cache/
.DS_Store

# LM response caches are machine-local. Committing one would make reported
# timings and LM-call counts irreproducible while looking like results.
.dspy_cache/
.litellm_cache/

# data/northwind.sqlite IS committed: the assessment lists "data/ including the
# database" as a deliverable. Transient sqlite sidecars are not.
data/*.sqlite-wal
data/*.sqlite-shm
data/*.sqlite-journal
